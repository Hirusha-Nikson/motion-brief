{
  "description": "Vertical tech-stack video with icon grids. Edit: add one icon to the frontend scene. Icon ids are provisional until the icon library is integrated (Phase 6).",
  "brief": {
    "id": "example-tech-stack-icons",
    "createdAt": "2026-10-10T00:00:00.000Z",
    "platform": "shorts",
    "audience": "Developers choosing a web stack",
    "purpose": "Show the team's stack, layer by layer",
    "theme": {
      "palette": {
        "background": "#09090b",
        "surface": "#18181b",
        "primary": "#a78bfa",
        "accent": "#34d399",
        "text": "#fafafa",
        "mutedText": "#a1a1aa"
      },
      "fonts": { "heading": "JetBrains Mono", "body": "Inter" },
      "motionStyle": "snappy",
      "cornerRadius": 20
    },
    "scenes": [
      { "type": "title", "onScreenText": ["Our stack in 20 seconds"] },
      {
        "id": "frontend",
        "type": "icon-grid",
        "onScreenText": ["Frontend", "React", "TypeScript", "Vite"],
        "icons": ["react", "typescript", "vite"]
      },
      {
        "id": "backend",
        "type": "icon-grid",
        "onScreenText": ["Backend", "Node.js", "PostgreSQL", "Docker"],
        "icons": ["nodejs", "postgresql", "docker"]
      },
      {
        "id": "ship",
        "type": "icon-grid",
        "onScreenText": ["Ship it", "GitHub Actions", "Cloudflare"],
        "icons": ["github-actions", "cloudflare"]
      },
      { "type": "cta", "onScreenText": ["Want the template?", "Comment STACK"] }
    ]
  },
  "edit": {
    "description": "Add Tailwind CSS to the frontend scene (scene frontend only).",
    "ops": [
      { "op": "add", "path": "/scenes/1/icons/-", "value": "tailwindcss" },
      {
        "op": "add",
        "path": "/scenes/1/onScreenText/-",
        "value": { "role": "label", "text": "Tailwind CSS", "maxChars": 32 }
      }
    ]
  }
}
