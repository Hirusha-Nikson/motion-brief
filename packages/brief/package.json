{
  "name": "@motionbrief/brief",
  "version": "0.0.0",
  "description": "Shared motion-brief/v1 schema, presets, defaults, estimate, prompt compiler and edit patches",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "pnpm build && node scripts/generate.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "rfc6902": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
