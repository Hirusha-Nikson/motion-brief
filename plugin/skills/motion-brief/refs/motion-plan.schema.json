{
  "$id": "https://github.com/Hirusha-Nikson/motion-brief/schemas/motion-plan.v1.json",
  "title": "motion-plan/v1",
  "description": "The confirmed script and scene plan for a MotionBrief video, read by scripts/render_video.py together with the brief.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "motion-plan/v1"
    },
    "briefHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "scenes": {
      "minItems": 1,
      "maxItems": 120,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "pattern": {
            "type": "string",
            "enum": [
              "title",
              "kinetic-text",
              "bullets",
              "stat",
              "chart",
              "icon-grid",
              "image-focus",
              "quote",
              "comparison",
              "cta"
            ]
          },
          "durationSec": {
            "type": "number",
            "minimum": 1,
            "maximum": 120
          },
          "text": {
            "default": [],
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "headline",
                    "subhead",
                    "body",
                    "label",
                    "stat",
                    "quote",
                    "attribution",
                    "cta"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "voiceover": {
            "default": "",
            "type": "string",
            "maxLength": 2000
          },
          "icons": {
            "default": [],
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "image": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "stat": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "prefix": {
                "default": "",
                "type": "string",
                "maxLength": 8
              },
              "suffix": {
                "default": "",
                "type": "string",
                "maxLength": 12
              },
              "decimals": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          "chart": {
            "type": "object",
            "properties": {
              "values": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "labels": {
                "default": [],
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "prefix": {
                "default": "",
                "type": "string",
                "maxLength": 8
              },
              "suffix": {
                "default": "",
                "type": "string",
                "maxLength": 12
              }
            },
            "required": [
              "values"
            ],
            "additionalProperties": false
          },
          "transition": {
            "default": "fade",
            "type": "string",
            "enum": [
              "cut",
              "fade",
              "slide-up",
              "slide-left",
              "wipe",
              "zoom",
              "pop"
            ]
          }
        },
        "required": [
          "id",
          "pattern",
          "durationSec"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "briefHash",
    "title",
    "scenes"
  ],
  "additionalProperties": false
}
